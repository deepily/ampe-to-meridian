  {"name": "term_gpa",           "type": "FLOAT64", "mode": "NULLABLE", "description": "Term GPA (0.0-4.0)"},
  {"name": "cumulative_gpa",     "type": "FLOAT64", "mode": "NULLABLE", "description": "Cumulative GPA (0.0-4.0)"},
  {"name": "credits_attempted",  "type": "INT64",   "mode": "NULLABLE", "description": "Credits attempted this term"},
  {"name": "credits_earned",     "type": "INT64",   "mode": "NULLABLE", "description": "Credits earned this term"},
  {"name": "course_count",       "type": "INT64",   "mode": "NULLABLE", "description": "Number of courses this term"},
  {"name": "major",              "type": "STRING",  "mode": "NULLABLE", "description": "Declared major"},
  {"name": "major_changed_flag", "type": "BOOLEAN", "mode": "NULLABLE", "description": "Changed major this term"},
  {"name": "academic_standing",  "type": "STRING",  "mode": "NULLABLE", "description": "Academic standing (good/probation/suspension)"},
